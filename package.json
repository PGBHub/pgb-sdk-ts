{
  "name": "@pgb/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript and Node.js SDK for PGBHub Cloud: database, auth, storage, mail, functions, cron, jobs, queues, realtime and actions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pgb": "./bin/pgb.js",
    "pgbhub": "./bin/pgbhub.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test test-dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PGBHub/pgb-sdk-ts.git"
  },
  "keywords": [
    "actions",
    "auth",
    "authentication",
    "codegen",
    "cron",
    "database",
    "pgbhub",
    "postgres",
    "postgresql",
    "queues",
    "realtime",
    "sdk",
    "sdk-typescript",
    "serverless"
  ],
  "author": "Hydratik <engineering@pgbhub.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/PGBHub/pgb-sdk-ts/issues"
  },
  "homepage": "https://github.com/PGBHub/pgb-sdk-ts#readme"
}
